{
  "openapi": "3.1.0",
  "info": {
    "title": "Unified Digital Platform API",
    "description": "Enterprise-grade Unified Digital Platform backend API (modular routers; JWT auth; Postgres persistence).",
    "version": "0.1.0"
  },
  "tags": [
    {
      "name": "health",
      "description": "Service health and diagnostics."
    },
    {
      "name": "auth",
      "description": "Authentication, JWT issuance, and MFA scaffolding."
    },
    {
      "name": "applications",
      "description": "Application lifecycle endpoints (submission, status, etc.)."
    },
    {
      "name": "workflow",
      "description": "Workflow/BPM and task management endpoints."
    },
    {
      "name": "inspections",
      "description": "Inspection creation and tracking."
    },
    {
      "name": "documents",
      "description": "Document metadata/content management boundaries (metadata persisted)."
    },
    {
      "name": "ticketing",
      "description": "Helpdesk/ticketing module boundaries."
    },
    {
      "name": "payments",
      "description": "Payment gateway boundaries (persistence implemented; gateway still stubbed)."
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health check",
        "description": "Basic health check endpoint.",
        "operationId": "health_check__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/docs/help": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Docs usage help",
        "description": "Quick usage notes for authentication and common calls.",
        "operationId": "docs_help",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register new user",
        "description": "Create a new user account and return an access token.",
        "operationId": "auth_register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "description": "Authenticate with email/password and return an access token. MFA code required if MFA enabled (scaffolding).",
        "operationId": "auth_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Get current user info",
        "description": "Return user id and claims from bearer token.",
        "operationId": "auth_me",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/auth/mfa/enroll": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Enroll MFA (scaffolding)",
        "description": "Enable MFA for current user and return a placeholder provisioning URI (stub).",
        "operationId": "auth_mfa_enroll",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MFAEnrollResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/applications": {
      "post": {
        "tags": [
          "applications"
        ],
        "summary": "Create application",
        "description": "Create a new application and persist it to Postgres.",
        "operationId": "applications_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicationCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/applications/{application_id}": {
      "get": {
        "tags": [
          "applications"
        ],
        "summary": "Get application",
        "description": "Fetch an application by id from Postgres.",
        "operationId": "applications_get",
        "parameters": [
          {
            "name": "application_id",
            "in": "path",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string",
              "title": "Application Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/workflow/tasks": {
      "post": {
        "tags": [
          "workflow"
        ],
        "summary": "Create task",
        "description": "Create a workflow task (Postgres-backed).",
        "operationId": "workflow_tasks_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/workflow/tasks/{task_id}": {
      "get": {
        "tags": [
          "workflow"
        ],
        "summary": "Get task",
        "description": "Fetch a workflow task from Postgres.",
        "operationId": "workflow_tasks_get",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Task Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ApplicationCreateRequest": {
        "properties": {
          "applicant_name": {
            "type": "string",
            "title": "Applicant Name",
            "description": "Applicant display name."
          },
          "service_code": {
            "type": "string",
            "title": "Service Code",
            "description": "Service/module identifier for the application."
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload",
            "description": "Arbitrary application form payload."
          }
        },
        "type": "object",
        "required": [
          "applicant_name",
          "service_code"
        ],
        "title": "ApplicationCreateRequest"
      },
      "ApplicationResponse": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string",
            "title": "Id",
            "description": "Application id."
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Application lifecycle status."
          },
          "applicant_name": {
            "type": "string",
            "title": "Applicant Name",
            "description": "Applicant display name."
          },
          "service_code": {
            "type": "string",
            "title": "Service Code",
            "description": "Service/module identifier."
          },
          "created_at": {
            "format": "date-time",
            "type": "string",
            "title": "Created At",
            "description": "Creation timestamp."
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "applicant_name",
          "service_code",
          "created_at"
        ],
        "title": "ApplicationResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "format": "email",
            "type": "string",
            "title": "Email",
            "description": "User email."
          },
          "password": {
            "type": "string",
            "title": "Password",
            "description": "User password."
          },
          "mfa_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mfa Code",
            "description": "MFA code (scaffolding). When MFA is enabled for user, this must be provided.",
            "default": null
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "MFAEnrollResponse": {
        "properties": {
          "mfa_enabled": {
            "type": "boolean",
            "title": "Mfa Enabled",
            "description": "Whether MFA is enabled after this operation."
          },
          "provisioning_uri": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provisioning Uri",
            "description": "Provisioning URI/QR payload for authenticator apps (stub/scaffolding).",
            "default": null
          }
        },
        "type": "object",
        "required": [
          "mfa_enabled"
        ],
        "title": "MFAEnrollResponse"
      },
      "MeResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "Authenticated user id."
          },
          "claims": {
            "type": "object",
            "title": "Claims",
            "description": "Token claims."
          }
        },
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "MeResponse"
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "format": "email",
            "type": "string",
            "title": "Email",
            "description": "User email address (unique)."
          },
          "password": {
            "type": "string",
            "title": "Password",
            "description": "User password (min length 8).",
            "minLength": 8
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "RegisterRequest"
      },
      "TaskCreateRequest": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Task title."
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "description": "Task description.",
            "default": null
          },
          "application_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Application Id",
            "description": "Optional related application id.",
            "default": null
          },
          "assignee_user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assignee User Id",
            "description": "Optional assignee user id.",
            "default": null
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "TaskCreateRequest"
      },
      "TaskResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Task id."
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Task title."
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Task status."
          },
          "created_at": {
            "format": "date-time",
            "type": "string",
            "title": "Created At",
            "description": "Creation timestamp."
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "created_at"
        ],
        "title": "TaskResponse"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token",
            "description": "JWT access token."
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "description": "Token type.",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": [
          "access_token"
        ],
        "title": "TokenResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
